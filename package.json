{
  "name": "trendings",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "auth:hash": "tsx scripts/hash-password.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker/index.ts",
    "ingest": "node --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "eval": "vitest run eval"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.18",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "pg-boss": "12.39.0",
    "pgvector": "0.3.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "3.13.0",
    "sanitize-html": "2.18.2",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "tldts": "7.5.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
